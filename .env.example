# WiFi Credentials
WIFI_SSID=YOUR_WIFI_SSID
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# Device Configuration
DEVICE_ID=ESP32-001
INTERVAL_SECONDS=30

# MQTT Broker (Public broker for testing)
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=enose/ESP32-001/measurement

# OTA Firmware Update (optional, leave empty for no OTA)
OTA_URL=

# Backend Dashboard (for verification)
# https://enose-cloud-backend-production-facd.up.railway.app/dashboard
