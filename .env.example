# Local development defaults
HOST=0.0.0.0
PORT=8080
# Local: sqlite://./enose.db
# Azure PostgreSQL: postgres://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/enose?sslmode=require
# Railway PostgreSQL: automatically injected via ${{Postgres.DATABASE_URL}}
DATABASE_URL=sqlite://./enose.db
RUST_LOG=info

# MQTT Configuration
# Set MQTT_ENABLED=true to enable MQTT subscriber
MQTT_ENABLED=false
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=enose-cloud
# Topic supports wildcards: enose/+/measurement subscribes to enose/ESP32-001/measurement, etc.
MQTT_TOPIC=enose/+/measurement
MQTT_TLS=false

# Optional OTA provider integration owned by Bagian B.
OTA_BASE_URL=
OTA_API_TOKEN=
